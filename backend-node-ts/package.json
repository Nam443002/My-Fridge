    "@nestjs/passport": "^10.0.0",
    "passport":         "^0.7.0",
    "passport-jwt":     "^4.0.1",
    "pg":               "^8.11.5",
    "ioredis":          "^5.4.1",
    "minio":            "^8.0.0",
    "zod":              "^3.23.8",
    "dotenv":           "^16.4.5",
    "bcrypt":           "^5.1.1",
