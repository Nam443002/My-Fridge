# ── Application ──────────────────────────────────────────
APP_NAME=SmartMeal-AI
APP_ENV=development
TIMEZONE=Asia/Ho_Chi_Minh

# ── PostgreSQL + pgvector ─────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=myfridge_db
DB_USER=myfridge_user
DB_PASSWORD=myfridge_secure_password_2026

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2026
REDIS_TTL_HOURS=24

# ── MinIO ─────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword2026
MINIO_BUCKET_NAME=myfridge-media

# ── NestJS Backend ────────────────────────────────────────
SERVER_PORT=3000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=4c9a87d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=com.myfridge.backend

# ── FastAPI AI Service ────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000
YOLO_MODEL_PATH=/app/weights/yolov8n_food.pt
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
FASTAPI_WORKERS=2

# ── Gemini API ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TEXT=gemini-1.5-flash
GEMINI_MODEL_VISION=gemini-1.5-flash

# ── Firebase Cloud Messaging ──────────────────────────────
FIREBASE_PROJECT_ID=smartmeal-ai-fcm
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
FCM_ENABLED=true

# ── Nginx ─────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
